#!/usr/bin/env python3
"""Host terminal entrypoint: no values on argv, stdout or the environment."""
import sys
import hive_secrets

if __name__ == '__main__':
    try:
        hive_secrets.main()
    except hive_secrets.SecretError as error:
        print('hive-secret: ' + str(error), file=sys.stderr)
        sys.exit(1)
    except (OSError, ValueError, RuntimeError, EOFError) as error:
        print('hive-secret: host operation failed (' + type(error).__name__ + ')', file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print('hive-secret: cancelled', file=sys.stderr)
        sys.exit(130)
